# Official sources pinned independently from the ROS distribution snapshot.
let
  overlay = builtins.getFlake "github:lopsided98/nix-ros-overlay/814d97b0b7236c0834fc079effa55acabb269926";
  pkgs = import overlay.inputs.nixpkgs {
    system = builtins.currentSystem;
    overlays = [ overlay.overlays.default ];
  };
  ros = pkgs.rosPackages.jazzy;
  g2o = pkgs.g2o.overrideAttrs (old: {
    version = "20230223";
    src = builtins.fetchGit {
      url = "https://github.com/RainerKuemmerle/g2o.git";
      rev = "e8df2004e07ea8f5b8e6a8b9f2dc067b45b45036";
      ref = "refs/tags/20230223_git";
    };
    patches = [];
    cmakeFlags = [ "-DCMAKE_POLICY_VERSION_MINIMUM=3.5" "-DG2O_BUILD_APPS=OFF"
      "-DG2O_BUILD_EXAMPLES=OFF" "-DG2O_USE_OPENGL=OFF" "-DG2O_USE_CHOLMOD=OFF"
      "-DG2O_USE_CSPARSE=ON" "-DBUILD_SHARED_LIBS=ON" ];
  });
  stella = pkgs.stdenv.mkDerivation {
    pname = "stella-vslam";
    version = "0.7.0-e445b545";
    src = builtins.fetchGit {
      url = "https://github.com/stella-cv/stella_vslam.git";
      rev = "e445b5452535e781fdf6777ec33a06f5f8f5e416";
      submodules = true;
    };
    nativeBuildInputs = with pkgs; [ cmake ninja pkg-config ];
    # g2oConfig.cmake requires OpenGL even when its viewer targets are disabled.
    buildInputs = with pkgs; [ opencv4 eigen yaml-cpp sqlite spdlog suitesparse g2o libGL ];
    cmakeFlags = [ "-DCMAKE_POLICY_VERSION_MINIMUM=3.5" "-DUSE_CCACHE=OFF"
      "-DUSE_GTSAM=OFF" "-DUSE_ARUCO=OFF" "-DBUILD_TESTS=OFF" ];
    enableParallelBuilding = true;
  };
  wrapper = ros.buildRosPackage {
    pname = "stella-vslam-ros";
    version = "0.2.1-186f623d";
    src = builtins.fetchGit {
      url = "https://github.com/stella-cv/stella_vslam_ros.git";
      rev = "186f623dd1c24ee83678f8e1da593801f450bbb3";
      ref = "ros2";
      submodules = true;
    };
    buildType = "ament_cmake";
    # Current ament already generates this hook for the shared library. The
    # wrapper's manual duplicate makes CMake4 reject library_path.dsv generation.
    postPatch = ''
      substituteInPlace CMakeLists.txt --replace-fail 'if(NOT WIN32)
        ament_environment_hooks(
          "''${ament_cmake_package_templates_ENVIRONMENT_HOOK_LIBRARY_PATH}")
      endif()' '# library path hook is generated by ament'
      substituteInPlace src/stella_vslam_ros.h \
        --replace-fail 'cv_bridge/cv_bridge.h' 'cv_bridge/cv_bridge.hpp'
    '';
    nativeBuildInputs = [ pkgs.cmake ros.ament-cmake ];
    buildInputs = with ros; [ rclcpp rclcpp-components cv-bridge image-transport
      message-filters geometry-msgs nav-msgs sensor-msgs tf2 tf2-eigen
      tf2-geometry-msgs tf2-msgs tf2-ros rosbag2-cpp stella pkgs.yaml-cpp pkgs.spdlog
      g2o pkgs.libGL pkgs.suitesparse pkgs.sqlite ];
    cmakeFlags = [ "-DCMAKE_POLICY_VERSION_MINIMUM=3.5" ];
  };
in ros.buildEnv {
  # Keep g2o2023 (stella) and the distribution's g2o2024 (RTAB-Map) in
  # separate environments; they export overlapping headers/library names.
  paths = with ros; [ ros-core rclpy cv-bridge sensor-msgs nav-msgs geometry-msgs
    rosgraph-msgs tf2-ros rtabmap-msgs rclcpp-components image-transport
    message-filters tf2-eigen tf2-geometry-msgs tf2-msgs rosbag2-cpp wrapper ];
}
