{
  "name": "slam-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "scripts": {
    "postinstall": "node scripts/install-rumoca-package.mjs",
    "models:init": "node scripts/init-modelica-models.mjs",
    "predev": "npm run models:init",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run models:init",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "node scripts/assets.mjs && node scripts/slam-native-assets.mjs",
    "pretest": "npm run models:init",
    "test": "vitest run",
    "test:comparison": "bash scripts/test-slam-comparison.sh",
    "test:loop-consensus": "node --test --test-concurrency=1 scripts/loop-consensus-probe.test.mjs scripts/loop-consensus-probe-numerics.test.mjs",
    "test:browser": "playwright test",
    "test:compiler-admission": "vitest run --config vitest.compiler.config.ts",
    "test:browser:gpu": "playwright test --config playwright.gpu.config.ts",
    "test:browser:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:office-ci": "node --test --test-concurrency=1 scripts/office-ci-contract.test.mjs scripts/verify-office-ci-artifacts.test.mjs scripts/office-phase-b-admission.test.mjs scripts/admit-phase-b-capture.test.mjs scripts/office-native-observation.test.mjs scripts/office-consensus-orchestration.test.mjs scripts/office-ci-worker-boot.test.mjs scripts/office-ci-preparation.test.mjs",
    "test:office-ci-kernels": "node --test --test-concurrency=1 scripts/loop-consensus-probe.test.mjs scripts/loop-consensus-probe-numerics.test.mjs scripts/loop-catalog-snapshot.test.mjs scripts/office-pair-adapter.test.mjs scripts/loop-pair-reconstruction.test.mjs"
  },
  "dependencies": {
    "@cognipilot/rumoca": "0.10.2",
    "@cognipilot/synapse-fbs": "0.10.0",
    "@mlc-ai/web-llm": "0.2.86",
    "flatbuffers": "^25.9.23",
    "monaco-editor": "0.55.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wabt": "1.0.39"
  },
  "license": "Apache-2.0"
}
