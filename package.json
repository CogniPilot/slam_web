{
  "name": "slam-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "models:init": "node scripts/init-modelica-models.mjs",
    "predev": "npm run models:init",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run models:init",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "assets": "node scripts/assets.mjs",
    "pretest": "npm run models:init",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:compiler-admission": "vitest run --config vitest.compiler.config.ts",
    "test:browser:gpu": "playwright test --config playwright.gpu.config.ts"
  },
  "dependencies": {
    "@cognipilot/rumoca": "0.10.2",
    "@cognipilot/synapse-fbs": "0.10.0",
    "flatbuffers": "^25.9.23",
    "monaco-editor": "0.55.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "@types/three": "0.180.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wabt": "1.0.39"
  },
  "license": "Apache-2.0"
}
